{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/noticias/contact",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/noticias/contact/",
      "destination": "/contacto",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/noticias/:slug",
      "destination": "/noticias/:slug.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [{ "source": "/alta-cliente/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Referrer-Policy", "value": "same-origin" }] }],
  "functions": { "api/alta-clientes.js": { "maxDuration": 30 } }
}
